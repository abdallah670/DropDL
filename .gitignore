node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Rust / Cargo build output
/src-tauri/target/
/target/

# Installers and release artifacts — attach these to a GitHub Release, never commit
# them: they are ~140 MB each and would bloat every clone of the repository.
*.msi
*.msi.sig
DropDL_*-setup.exe
DropDL-*-portable.zip
*.appx
*.deb
*.rpm
*.AppImage

# Download engine binaries (yt-dlp + FFmpeg + FFprobe, ~330 MB total).
# NEVER commit these: GitHub rejects files >100 MB on a normal push, and the
# 408/timeout you hit was exactly this. Developers and CI download the engine
# instead — see "Download engine" in README.md. The files stay on your disk;
# this only stops git from tracking them.
src-tauri/bin/*.exe
src-tauri/bin/*.tmp
!src-tauri/bin/.gitkeep

# Build scratch files
build_log.txt
build_release_log.txt
flat_test.json
