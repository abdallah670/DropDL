{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:3000",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "DropDL",
    "version": "1.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "path": { "all": true },
      "shell": {
        "all": false,
        "execute": false,
        "open": "^(https?://|mailto:)",
        "sidecar": false
      },
      "dialog": {
        "all": false,
        "open": true,
        "save": true
      },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "createDir": true,
        "renameFile": true,
        "removeFile": true,
        "exists": true,
        "scope": ["$DOWNLOAD/*", "$DOCUMENT/*", "$DESKTOP/*", "$APPDATA/*", "$APPDATA"]
      },
      "notification": {
        "all": true
      },
      "clipboard": {
        "all": false,
        "readText": true,
        "writeText": true
      },
      "window": {
        "all": false,
        "startDragging": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.dropdl.desktop",
      "externalBin": [
        "bin/yt-dlp",
        "bin/ffmpeg",
        "bin/ffprobe"
      ],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "windows": [
      {
        "title": "DropDL",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ]
  }
}
