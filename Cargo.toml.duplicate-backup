[package]
name = "dropdl"
version = "1.0.0"
description = "Desktop GUI for yt-dlp and FFmpeg"
authors = ["DropDL Team"]
license = "MIT"
edition = "2021"

[build-dependencies]
tauri-build = { version = "1.5", features = [] }

[dependencies]
tauri = { version = "1.5", features = [
  "clipboard-read-text",
  "clipboard-write-text",
  "dialog-open",
  "dialog-save",
  "fs-create-dir",
  "fs-exists",
  "fs-read-file",
  "fs-remove-file",
  "fs-rename-file",
  "fs-write-file",
  "notification-all",
  "path-all",
  "process-command-api",
  "shell-open",
  "window-start-dragging",
] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
tokio = { version = "1.0", features = ["full"] }
dirs = "5"

[features]
custom-protocol = ["tauri/custom-protocol"]

[profile.dev]
codegen-units = 1

[profile.dev.build-override]
codegen-units = 1

[profile.release]
codegen-units = 1

[profile.release.build-override]
codegen-units = 1

